rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function forgeAdmin() {
      return signedIn()
        && request.auth.token.email == 'lulupotbeyblade47@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function validUsernameClaim(key) {
      return request.resource.data.uid == request.auth.uid
        && request.resource.data.key == key
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 20
        && key.matches('^[a-z0-9_-]{3,20}$');
    }

    match /usernames/{key} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && validUsernameClaim(key)
        && !exists(/databases/$(database)/documents/usernames/$(key));
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && validUsernameClaim(key);
      allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || forgeAdmin();
    }

    match /publicProfiles/{uid} {
      allow get: if signedIn();
      allow list: if forgeAdmin();
      allow create, update: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.username is string
        && request.resource.data.key is string
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.key)).data.uid == uid;
      allow delete: if owns(uid) || forgeAdmin();
    }

    match /users/{userId}/{document=**} {
      allow read, write: if owns(userId) || forgeAdmin();
    }
  }
}
