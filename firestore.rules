rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function forgeAdmin() {
      return signedIn()
        && request.auth.token.email == 'lulupotbeyblade47@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function validUsernameClaim(key) {
      return request.resource.data.uid == request.auth.uid
        && request.resource.data.key == key
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 20
        && key.matches('^[a-z0-9_-]{3,20}$');
    }

    match /usernames/{key} {
      allow get: if signedIn();
      allow list: if signedIn();
      allow create: if signedIn()
        && validUsernameClaim(key)
        && !exists(/databases/$(database)/documents/usernames/$(key));
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && validUsernameClaim(key);
      allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || forgeAdmin();
    }

    match /publicProfiles/{uid} {
      allow get: if signedIn();
      // liste lisible par les comptes connectés (recherche/annuaire Social) ;
      // l'invisibilité est filtrée côté client
      allow list: if signedIn();
      allow create, update: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.username is string
        && request.resource.data.key is string
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.key)).data.uid == uid;
      // like / unlike par un autre compte : UNIQUEMENT les champs de like,
      // et la cohérence likes == taille de la liste est imposée
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy'])
        && request.resource.data.likedBy is list
        && request.resource.data.likes == request.resource.data.likedBy.size()
        && (request.auth.uid in request.resource.data.likedBy || request.auth.uid in resource.data.likedBy);
      allow delete: if owns(uid) || forgeAdmin();
    }

    // ── Discussions (façon messagerie) ──
    // threads/{paireTriée} : conversation commune ; messages en sous-collection.
    // userThreads/{uid}/threads/{paire} : miroir par participant pour lister
    // "mes discussions" sans exposer celles des autres.
    function threadPairOf(ids) {
      return ids[0] < ids[1] ? ids[0] + '__' + ids[1] : ids[1] + '__' + ids[0];
    }
    match /threads/{pairKey} {
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] is string
        && request.resource.data.participants[1] is string
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && pairKey == threadPairOf(request.resource.data.participants);
      allow get, update: if signedIn() && request.auth.uid in resource.data.participants;
      allow list, delete: if false;
      match /messages/{mid} {
        allow create: if signedIn()
          && request.resource.data.from == request.auth.uid
          && request.resource.data.createdAt is string
          && request.resource.data.fromU is string
          && exists(/databases/$(database)/documents/threads/$(pairKey))
          && request.auth.uid in get(/databases/$(database)/documents/threads/$(pairKey)).data.participants
          && (!('text' in request.resource.data) || request.resource.data.text is string)
          && (!('bundle' in request.resource.data) || request.resource.data.bundle != null);
        allow get, list: if signedIn()
          && exists(/databases/$(database)/documents/threads/$(pairKey))
          && request.auth.uid in get(/databases/$(database)/documents/threads/$(pairKey)).data.participants;
        allow update, delete: if false;
      }
    }
    match /userThreads/{owner}/threads/{pairKey} {
      allow read: if owns(owner);
      allow create, update: if signedIn()
        && exists(/databases/$(database)/documents/threads/$(pairKey))
        && request.auth.uid in get(/databases/$(database)/documents/threads/$(pairKey)).data.participants
        && owner in get(/databases/$(database)/documents/threads/$(pairKey)).data.participants;
      allow delete: if owns(owner);
    }


    match /users/{userId}/{document=**} {
      allow read, write: if owns(userId) || forgeAdmin();
    }

    // Partage par pseudo : chaque compte Forge a une boîte titrée par
    // son pseudo (clé usernames). Envoyer = créer un document dans la
    // boîte du destinataire ; lire/supprimer = être le propriétaire du
    // pseudo. Le contenu des partages est public entre comptes, sans
    // données perso (juste profils/séances/exercices/progressions).
    function inboxOwner(key) {
      return signedIn()
        && exists(/databases/$(database)/documents/usernames/$(key))
        && get(/databases/$(database)/documents/usernames/$(key)).data.uid == request.auth.uid;
    }
    match /inbox/{key}/items/{item} {
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.to == key
        && request.resource.data.kind is string
        && request.resource.data.fromUsername is string
        && request.resource.data.bundle != null
        && (!('message' in request.resource.data) || request.resource.data.message is string)
        && exists(/databases/$(database)/documents/usernames/$(key));
      allow read, delete: if inboxOwner(key);
    }
  }
}
